# gadget plan generated by gadget_plan.py from capture.json
# options: name=device max_speed=as-described test_ids=no
# note: interface 6 (class 0xff 'vendor') has no standard gadget function, not reproduced
name device
write idVendor 0x1209
write idProduct 0x0001
write bcdDevice 0x0110
write bcdUSB 0x0200
write bDeviceClass 0x0000
write bDeviceSubClass 0x0000
write bDeviceProtocol 0x0000
write bMaxPacketSize0 64
write max_speed full-speed
mkdir strings/0x409
write strings/0x409/manufacturer
write strings/0x409/product
write strings/0x409/serialnumber
write hide_strings 4
mkdir strings/0x409/s4
write strings/0x409/s4/s
mkdir strings/0x409/s5
write strings/0x409/s5/s
mkdir configs/c.1
write configs/c.1/bmAttributes 0x0080
write configs/c.1/MaxPower 100
mkdir functions/uac1.0
write functions/uac1.0/function_name
write functions/uac1.0/int_ep_present 0
write functions/uac1.0/c_chmask 3
write functions/uac1.0/c_ssize 2
write functions/uac1.0/c_srate 48000
write functions/uac1.0/c_mute_present 1
write functions/uac1.0/c_volume_present 1
write functions/uac1.0/c_volume_min -19712
write functions/uac1.0/c_volume_max 0
write functions/uac1.0/c_volume_res 1
write functions/uac1.0/c_terminal_type 770
write functions/uac1.0/c_ot_name
write functions/uac1.0/c_it_name
write functions/uac1.0/c_fu_vol_name
write functions/uac1.0/c_it_ch_name
write functions/uac1.0/c_alt0_name
write functions/uac1.0/c_alt1_name
write functions/uac1.0/c_max_packet_size 192
write functions/uac1.0/c_ep_num 3
write functions/uac1.0/c_it_id 38
write functions/uac1.0/c_ot_id 36
write functions/uac1.0/c_fu_id 34
write functions/uac1.0/fu_control_size 1
write functions/uac1.0/p_chmask 1
write functions/uac1.0/p_ssize 2
write functions/uac1.0/p_srate 48000
write functions/uac1.0/p_mute_present 1
write functions/uac1.0/p_volume_present 1
write functions/uac1.0/p_volume_min -21248
write functions/uac1.0/p_volume_max 0
write functions/uac1.0/p_volume_res 1
write functions/uac1.0/p_terminal_type 1026
write functions/uac1.0/p_it_name
write functions/uac1.0/p_ot_name
write functions/uac1.0/p_fu_vol_name
write functions/uac1.0/p_it_ch_name
write functions/uac1.0/p_alt0_name
write functions/uac1.0/p_alt1_name
write functions/uac1.0/p_max_packet_size 96
write functions/uac1.0/p_ep_num 3
write functions/uac1.0/p_ot_id 39
write functions/uac1.0/p_it_id 35
write functions/uac1.0/p_fu_id 40
write functions/uac1.0/fu_control_size 1
link functions/uac1.0 configs/c.1/uac1.0
mkdir functions/hid.0
write functions/hid.0/protocol 0
write functions/hid.0/subclass 0
write functions/hid.0/report_length 64
hex functions/hid.0/report_desc 06c0ff0901a10106c1ff150026ff00750809f09540810209f19540910209f2960202b102c0
write functions/hid.0/name
write functions/hid.0/bcd_hid 272
write functions/hid.0/country_code 0
write? functions/hid.0/no_out_endpoint 1
write? functions/hid.0/interval 1
link functions/hid.0 configs/c.1/hid.0
mkdir functions/hid.1
write functions/hid.1/protocol 0
write functions/hid.1/subclass 0
write functions/hid.1/report_length 4
hex functions/hid.1/report_desc 050c0901a10109e909ea750195021500250181027506950181039503750109b609cd09b58102751595018103c0
write functions/hid.1/name
write functions/hid.1/bcd_hid 272
write functions/hid.1/country_code 0
write? functions/hid.1/no_out_endpoint 1
write? functions/hid.1/interval 1
link functions/hid.1 configs/c.1/hid.1
mkdir functions/hid.2
write functions/hid.2/protocol 0
write functions/hid.2/subclass 0
write functions/hid.2/report_length 64
hex functions/hid.2/report_desc 0600ff0901a1010601ff150026ff00750809f09540810209f195409102c0
write functions/hid.2/name
write functions/hid.2/bcd_hid 272
write functions/hid.2/country_code 0
write? functions/hid.2/no_out_endpoint 1
write? functions/hid.2/interval 1
link functions/hid.2 configs/c.1/hid.2
